{
  "name": "borrius-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && wrangler dev --ip 127.0.0.1 --port 8787",
    "dev:client": "vite --host 127.0.0.1",
    "build:client": "vite build",
    "build": "npm run build:client && wrangler deploy --env production --dry-run --outdir dist/worker",
    "deploy": "npm run check && npm run build:client && wrangler deploy --env production",
    "test": "tsx --test test/*.test.ts test/*.test.js",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test:e2e": "node tools/reset-e2e.mjs && playwright test",
    "test:integration": "tsx test/integration.ts",
    "test:lint-rules": "tsx --test tools/oxlint/anti-slop/rules/*.test.ts tools/oxlint/anti-slop/effect/rules/*.test.ts"
  },
  "dependencies": {
    "effect": "3.22.1",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@oxlint/plugins": "1.81.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
